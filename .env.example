# Neon Postgres connection string (pooled). Leave empty to persist to .data/state.json instead.
DATABASE_URL=

# Testnet speed multiplier. 1 = real time (5 min shifts). 10 = 30 second shifts for quick testing.
SHIFT_SPEED=1

# Optional: real explorer / Pons base URLs. Without them, explorer links stay disabled (simulated chain).
NEXT_PUBLIC_EXPLORER_URL=
NEXT_PUBLIC_PONS_URL=
