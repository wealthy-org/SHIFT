# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Neon Postgres connection string (pooled). Leave empty to persist to .data/state.json instead.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signs the session and nonce cookies. Required in production; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Unlocks /testnet (spawn scenarios, RPC failure, reorg, double-claim attempts).
# Unset: open in development, closed in production.
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Chain (Robinhood Chain testnet)
# ---------------------------------------------------------------------------
# Used to ask the wallet to switch networks, and to add the network if it is unknown.
# Leave NEXT_PUBLIC_CHAIN_ID empty to skip the network check entirely.
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain Testnet
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_CURRENCY_SYMBOL=ETH

# Explorer and Pons base URLs. Without them the proof links stay disabled,
# because the current ledger is simulated and those hashes exist nowhere else.
NEXT_PUBLIC_EXPLORER_URL=
NEXT_PUBLIC_PONS_URL=

# ---------------------------------------------------------------------------
# Simulation
# ---------------------------------------------------------------------------
# Simulated co-workers so a fresh office is not empty. 0 = real employees only.
SHIFT_BOTS=12

# Testnet clock multiplier. 1 = real time (5 minute shifts). 10 = 30 second shifts.
SHIFT_SPEED=1

# How often engine state is written to storage, in seconds (minimum 15).
SHIFT_SAVE_SECONDS=60

# ---------------------------------------------------------------------------
# Testnet signing keys (Batch B, contracts)
# ---------------------------------------------------------------------------
# Burner keys only, funded from a faucet. Never a personal wallet, never committed.
# Generate a pair with:
#   node -e "const{generatePrivateKey,privateKeyToAccount}=require('viem/accounts');const k=generatePrivateKey();console.log(k,privateKeyToAccount(k).address)"
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=
SIGNER_ADDRESS=
SIGNER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Deployed contracts (Robinhood Chain testnet, chain 46630)
# ---------------------------------------------------------------------------
EMPLOYEE_REGISTRY=
RANK_MANAGER=
SHIFT_MANAGER=
PAYROLL_VAULT=
PAYROLL_DISTRIBUTOR=
PONS_ADAPTER=
