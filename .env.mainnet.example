# ---------------------------------------------------------------------------
# Mainnet production env template. Copy to .env.production.local and fill in.
# Never commit the filled-in file. Never put a real private key in here —
# the app only needs SIGNER_PRIVATE_KEY (backend finalizer/payroll bot) and
# that should be a dedicated hot wallet funded only with what it needs to
# operate, not the deployer/admin/treasury key.
# ---------------------------------------------------------------------------

DATABASE_URL=
AUTH_SECRET=

# Leave empty to disable the /testnet debug console in production.
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Chain (mainnet)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_CURRENCY_SYMBOL=ETH
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com
NEXT_PUBLIC_PONS_URL=
# Robinhood Chain's public RPC is rate-limited per Robinhood's own docs — for
# production traffic, use a commercial RPC provider (Alchemy/QuickNode) that
# supports chain 4663 instead of the URL above.

# ---------------------------------------------------------------------------
# Data mode
# ---------------------------------------------------------------------------
DATA_MODE=live
EPOCH_GRANT_ETH=

# ---------------------------------------------------------------------------
# Backend signer (finalizer/payroll bot only — never the deployer/admin key)
# ---------------------------------------------------------------------------
SIGNER_ADDRESS=
SIGNER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Deployed contracts (mainnet) — fill from contracts/deployments/<chainId>.json
# after running the mainnet deploy.
# ---------------------------------------------------------------------------
EMPLOYEE_REGISTRY=
RANK_MANAGER=
SHIFT_MANAGER=
PAYROLL_VAULT=
PAYROLL_DISTRIBUTOR=
PONS_ADAPTER=
